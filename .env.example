# PostgreSQL connection string (provided by Dokploy or your Postgres provider)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/diario_turnos?schema=public"

# Secret used to sign session JWTs (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production-please-generate-a-random-secret"
SESSION_SECURE="true"

# Public app URL
NEXT_PUBLIC_APP_NAME="Diario de Turnos"

# Khipu (pagos online CLP). Si no se configuran, el checkout queda en modo demo
# (no se cobra; la orden se marca pagada manualmente desde /planes/gracias).
KHIPU_CLIENT_ID=""
KHIPU_CLIENT_SECRET=""
# URL pública de la app para return_url/notify_url de Khipu (ej: https://turnos.rincon-z.cl)
PUBLIC_APP_URL=""

# Secreto para el endpoint de recordatorios automáticos.
CRON_SECRET="generate-a-long-random-secret"

# Solo para entornos de prueba. Debe ser false o no definirse en producción.
DEMO_PAY_ENABLED="false"
